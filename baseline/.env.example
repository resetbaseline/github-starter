# Copy to .env.local and fill in values. .env.local is gitignored.
# Used for local `supabase functions serve` and tooling — production Edge Function secrets
# are set in Supabase Dashboard → Project Settings → Edge Functions → Secrets.
#
# After C1: apply migrations from repo root or baseline/:
#   cd baseline
#   supabase db push
# Verify SQL: run baseline/supabase/C1_VERIFICATION.sql in the SQL Editor.
# Shared util tests (requires Deno): cd baseline/supabase/functions && deno test --allow-env _shared/*.test.ts

# Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase Dashboard → Project Settings → API → anon public (safe for client + user JWT flows)
SUPABASE_ANON_KEY=

# Supabase Dashboard → Project Settings → API → service_role (secret; server/Edge Functions only)
SUPABASE_SERVICE_ROLE_KEY=

# https://console.anthropic.com/ → API keys → Create key
ANTHROPIC_API_KEY=

# Apple Developer → Keys → create APNs key → Key ID
APNS_KEY_ID=

# Apple Developer → Membership → Team ID
APNS_TEAM_ID=

# iOS app bundle identifier (matches Xcode)
APNS_BUNDLE_ID=com.resetbaseline.app

# Contents of the .p8 APNs private key (paste full PEM including BEGIN/END lines), or path if your tooling reads paths
APNS_PRIVATE_KEY=
